# Arquivo de configuração de chaves de API
# Obtenha sua chave gratuita em um dos provedores suportados e cole abaixo:

# 1. AI Music API / UdioAPI / SunoAPI (aimusicapi.com ou similar)
AI_MUSIC_API_KEY=sua_chave_aqui

# URL base da API escolhida (padrão AI Music API / Suno API):
API_BASE_URL=https://api.aimusicapi.ai

# 2. Google Gemini / Lyria API (opcional - Google AI Studio):
GEMINI_API_KEY=sua_chave_gemini_aqui

